{
  "name": "mariohdz-com",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // The contact form can only send to this verified address, from this sender.
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "contact@mariohdz.com",
      "allowed_sender_addresses": ["form@notify.mariohdz.com"]
    }
  ],
  // At most 10 messages a minute from one IP address, counted separately in each Cloudflare location.
  "ratelimits": [
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Workers Logs keeps the lines the Worker writes about each submission for seven days.
  // The automatic log of every request is off, so visitors' IP addresses and browsers aren't stored.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "routes": [
    { "pattern": "mariohdz.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false
}
